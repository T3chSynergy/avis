@page "/Kunden/{id:int}"
@model Avis.Web.Pages.Kunden.DetailsModel
@{
    var k = Model.Kunde;
    ViewData["Title"] = k.Name;
}
<p class="pfad"><a asp-page="Index">Kunden</a></p>
<h1>@k.Name @if (!k.Aktiv) { <span class="hinweis">inaktiv</span> }</h1>
@if (!k.Aktiv)
{
    <p class="erklaerung">Dieser Kunde ist als inaktiv markiert. Seine Aufträge bleiben erhalten, für neue Aufträge steht er nicht mehr zur Wahl.</p>
}

<div class="spalten">
    <section aria-labelledby="h-auftraege">
        <h2 id="h-auftraege">
            Laufende Aufträge
            @if (k.Aktiv) { <a class="nebenaktion" asp-page="/Auftraege/Neu" asp-route-kundeId="@k.Id">Auftrag für @k.Name erfassen</a> }
        </h2>
        <partial name="_Auftragsliste" model="new Avis.Web.Pages.Shared.Auftragsliste(Model.Laufend, OhneKunde: true)" />

        <h2>Abgeschlossene Aufträge</h2>
        <partial name="_Auftragsliste" model="new Avis.Web.Pages.Shared.Auftragsliste(Model.Abgeschlossen, OhneKunde: true)" />
        @if (Model.Gekuerzt)
        {
            <p class="erklaerung">Es werden die letzten @DetailsModel.Hoechstzahl abgeschlossenen Aufträge angezeigt.</p>
        }

        @if (Model.Geraete.Count > 0)
        {
            <h2>Geräte</h2>
            <ul>
                @foreach (var g in Model.Geraete)
                {
                    <li><a asp-page="/Geraete/Details" asp-route-id="@g.Id">@g.Inventarnummer</a> · @g.Bezeichnung</li>
                }
            </ul>
        }
    </section>

    <div>
    <form method="post" class="kasten">
        <h3>Angaben</h3>
        @if (k.AusQuelle)
        {
            <p class="erklaerung">Stammt aus @k.Quelle. Name, E-Mail, Telefon, Organisationseinheit und Standort werden dort gepflegt und beim Abgleich überschrieben. In AVIS lassen sie sich nicht ändern.</p>
        }
        <label for="name">Name</label>
        <input id="name" name="name" value="@k.Name" maxlength="200" required autocomplete="off" disabled="@k.AusQuelle" />
        <label for="email">E-Mail</label>
        <input id="email" name="email" type="email" value="@k.Email" maxlength="320" autocomplete="off" disabled="@k.AusQuelle" />
        <label for="telefon">Telefon</label>
        <input id="telefon" name="telefon" value="@k.Telefon" maxlength="50" autocomplete="off" disabled="@k.AusQuelle" />
        <label for="organisationseinheit">Organisationseinheit</label>
        <input id="organisationseinheit" name="organisationseinheit" value="@k.Organisationseinheit" maxlength="200" autocomplete="off" disabled="@k.AusQuelle" />
        <label for="standort">Standort, zum Beispiel der Raum</label>
        <input id="standort" name="standort" value="@k.Standort" maxlength="100" autocomplete="off" disabled="@k.AusQuelle" />
        @if (k.Anmeldename is not null)
        {
            <p class="erklaerung">Anmeldename: @k.Anmeldename</p>
        }
        @if (Telefonbuch.AdresseFuer(k.Anmeldename) is { } imTelefonbuch)
        {
            <p><a href="@imTelefonbuch" rel="noopener noreferrer">@Telefonbuch.Bezeichnung</a></p>
        }
        @if (!k.AusQuelle)
        {
            <button type="submit" class="haupt">Speichern</button>
        }
    </form>

    @if (!k.AusQuelle)
    {
        <form method="post" asp-page-handler="Aktiv" class="kasten">
            <h3>@(k.Aktiv ? "Als inaktiv markieren" : "Wieder aktivieren")</h3>
            <p class="erklaerung">
                @(k.Aktiv
                    ? "Der Kunde bleibt mit seinen Aufträgen erhalten, steht aber nicht mehr zur Wahl, wenn ein Auftrag erfasst wird."
                    : "Der Kunde steht danach wieder zur Wahl, wenn ein Auftrag erfasst wird.")
            </p>
            <button type="submit" name="aktiv" value="@(k.Aktiv ? "false" : "true")">@(k.Aktiv ? "Als inaktiv markieren" : "Wieder aktivieren")</button>
        </form>
    }
    </div>
</div>
