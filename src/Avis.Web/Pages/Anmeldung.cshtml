@page
@model AnmeldungModel
@{
    ViewData["Title"] = "Testanmeldung";
}
<h1>Testanmeldung</h1>
<p class="erklaerung">Diese Seite gibt es nur in der Entwicklungsumgebung. Im Betrieb erfolgt die Anmeldung über Windows.</p>

<form method="post">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <table class="liste schmal">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Rolle</th>
                <th scope="col"><span class="unsichtbar">Aktion</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Benutzer)
            {
                <tr>
                    <td>@b.Name</td>
                    <td>@(b.IstAdministrator ? "Administrator" : b.IstBearbeiter ? "Bearbeiter" : "Kunde")</td>
                    <td><button type="submit" name="anmeldename" value="@b.Anmeldename">Als @b.Name anmelden</button></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="kasten">
        <h3>Als neues Konto anmelden</h3>
        <p class="erklaerung">Wie jemand, der AVIS zum ersten Mal öffnet. Das Konto wird dabei angelegt und hat keine Rolle.</p>
        <label for="neu">Anmeldename</label>
        <input id="neu" name="neu" maxlength="200" autocomplete="off" />
        <button type="submit" name="anmeldename" value="">Anmelden</button>
    </div>
</form>

<div class="kasten">
    <h3>Mails</h3>
    @switch (Model.Mailart)
    {
        case Avis.Web.Mail.MailOptionen.Ordner:
            <p class="erklaerung">Mails werden nicht versendet, sondern als Dateien abgelegt. Ein Mailprogramm öffnet sie.</p>
            <p><code>@Model.Mailordner</code></p>
            break;
        case Avis.Web.Mail.MailOptionen.Smtp:
            <p class="erklaerung">Mails gehen an den eingestellten Mailserver (<code>Mail:Art = Smtp</code>).</p>
            break;
        default:
            <p class="erklaerung">Der Mailversand ist ausgeschaltet (<code>Mail:Art = Aus</code>). Mit <code>Ordner</code> landen Mails als Dateien auf diesem Rechner.</p>
            break;
    }
</div>

@if (Model.MitTestdaten)
{
    <form method="post" asp-page-handler="NeuAnlegen" class="kasten">
        <h3>Datenbank neu anlegen</h3>
        <p class="erklaerung">Leert die Datenbank und legt die Testdaten neu an. Alle Aufträge, Kunden, Geräte, Anhänge und selbst angelegten Konten gehen dabei verloren. Abgelegte Mails bleiben liegen.</p>
        <div class="ankreuz">
            <input type="checkbox" id="bestaetigt" name="bestaetigt" value="true" required />
            <label for="bestaetigt">Ja, alles löschen und neu anlegen</label>
        </div>
        <button type="submit">Datenbank neu anlegen</button>
    </form>
}
