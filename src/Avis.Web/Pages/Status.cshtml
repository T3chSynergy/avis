@page "/Status/{code:int}"
@attribute [Microsoft.AspNetCore.Mvc.IgnoreAntiforgeryToken]
@{
    var code = int.Parse((string)RouteData.Values["code"]!);
    var (titel, text) = code switch
    {
        403 => ("Kein Zugriff", "Dein Konto ist für diese Seite nicht freigeschaltet. AVIS steht derzeit nur Bearbeitern zur Verfügung."),
        404 => ("Nicht gefunden", "Diese Seite oder dieser Auftrag existiert nicht."),
        _ => ("Fehler", $"Die Anfrage konnte nicht verarbeitet werden (Status {code})."),
    };
    ViewData["Title"] = titel;
}
<h1>@titel</h1>
<p>@text</p>
<p><a asp-page="/Index">Zur Startseite</a></p>
