@model Avis.Web.Pages.Auftraege.AuftragFelder
@{
    var auswahl = (Avis.Web.Pages.Auftraege.AuftragAuswahl)ViewData["Auswahl"]!;
}
<div class="feld">
    <label asp-for="Betreff">Betreff</label>
    <input asp-for="Betreff" />
    <span asp-validation-for="Betreff" class="feldfehler"></span>
</div>
<div class="feld">
    <label asp-for="Beschreibung">Beschreibung</label>
    <textarea asp-for="Beschreibung" rows="6"></textarea>
    <span asp-validation-for="Beschreibung" class="feldfehler"></span>
</div>
<div class="reihe">
    <div class="feld">
        <label asp-for="KategorieId">Kategorie</label>
        <select asp-for="KategorieId" asp-items="auswahl.Kategorien">
            <option value="">–</option>
        </select>
        <span asp-validation-for="KategorieId" class="feldfehler"></span>
    </div>
    <div class="feld">
        <label asp-for="StandortId">Standort</label>
        <select asp-for="StandortId" asp-items="auswahl.Standorte">
            <option value="">–</option>
        </select>
        <span asp-validation-for="StandortId" class="feldfehler"></span>
    </div>
    <div class="feld">
        <label asp-for="Geraet">Gerät</label>
        <input asp-for="Geraet" />
        <span asp-validation-for="Geraet" class="feldfehler"></span>
    </div>
</div>
<div class="reihe">
    <div class="feld">
        <label asp-for="Dringlichkeit">Dringlichkeit</label>
        <select asp-for="Dringlichkeit">
            <option value="@Stufe.Niedrig">niedrig</option>
            <option value="@Stufe.Mittel">mittel</option>
            <option value="@Stufe.Hoch">hoch</option>
        </select>
    </div>
    <div class="feld">
        <label asp-for="Wichtigkeit">Wichtigkeit</label>
        <select asp-for="Wichtigkeit">
            <option value="@Stufe.Niedrig">niedrig</option>
            <option value="@Stufe.Mittel">mittel</option>
            <option value="@Stufe.Hoch">hoch</option>
        </select>
    </div>
    <div class="feld">
        <label asp-for="Termin">Termin</label>
        <input asp-for="Termin" type="date" />
    </div>
</div>
