@model Avis.Web.Pages.Auftraege.AuftragFelder
@{
    var auswahl = (Avis.Web.Pages.Auftraege.AuftragAuswahl)ViewData["Auswahl"]!;
}
<div class="feld">
    <label asp-for="Betreff">Betreff</label>
    <input asp-for="Betreff" required />
    <span asp-validation-for="Betreff" class="feldfehler"></span>
</div>
<div class="feld">
    <label asp-for="Beschreibung">Beschreibung</label>
    <textarea asp-for="Beschreibung" rows="6" data-markdown required></textarea>
    <span asp-validation-for="Beschreibung" class="feldfehler"></span>
    <span class="erklaerung">Geräte verknüpfst du im Text: „INV“ und die Inventarnummer, zum Beispiel <code>INV 4532436</code>.</span>
</div>
<div class="reihe">
    @* Drei Stufen nebeneinander statt einer Auswahlliste: Ein Klick genügt, und man sieht, was zur Wahl steht. *@
    <div class="feld">
        <div class="feldtitel" id="@Html.IdFor(m => m.Dringlichkeit)-titel">Dringlichkeit</div>
        <div class="stufen" role="radiogroup" aria-labelledby="@Html.IdFor(m => m.Dringlichkeit)-titel">
            @foreach (var stufe in Enum.GetValues<Stufe>())
            {
                <label><input type="radio" asp-for="Dringlichkeit" value="@stufe" id="@Html.IdFor(m => m.Dringlichkeit)-@stufe" class="unsichtbar" /><span>@stufe.Text()</span></label>
            }
        </div>
    </div>
    <div class="feld">
        <div class="feldtitel" id="@Html.IdFor(m => m.Wichtigkeit)-titel">Wichtigkeit</div>
        <div class="stufen" role="radiogroup" aria-labelledby="@Html.IdFor(m => m.Wichtigkeit)-titel">
            @foreach (var stufe in Enum.GetValues<Stufe>())
            {
                <label><input type="radio" asp-for="Wichtigkeit" value="@stufe" id="@Html.IdFor(m => m.Wichtigkeit)-@stufe" class="unsichtbar" /><span>@stufe.Text()</span></label>
            }
        </div>
    </div>
    <div class="feld">
        <label asp-for="KategorieId">Kategorie</label>
        <select asp-for="KategorieId" asp-items="auswahl.Kategorien">
            <option value="">–</option>
        </select>
        <span asp-validation-for="KategorieId" class="feldfehler"></span>
    </div>
    <div class="feld">
        <label asp-for="Termin">Termin (optional)</label>
        <input asp-for="Termin" type="date" />
    </div>
</div>
<p class="erklaerung">
    Dringlichkeit und Wichtigkeit ergeben zusammen die Priorität, von P1 (beides hoch) bis P5 (beides niedrig).
    <a asp-page="/Hilfe/Index" asp-fragment="prioritaet">Mehr dazu</a>
</p>
