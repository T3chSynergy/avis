@page
@model Avis.Web.Pages.Auftraege.NeuModel
@{
    ViewData["Title"] = "Auftrag erfassen";
    // Am Telefon tippt man zuerst den Namen des Anrufers.
    ViewData["Autofokus"] = "kundensuche";
}
<h1>Auftrag erfassen</h1>

<form method="post" class="formular" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="meldung fehler"></div>

    @* Die Eingabetaste in einem Textfeld löst die erste Schaltfläche des Formulars aus. Das soll das Erfassen sein, nicht die Suche. *@
    <button type="submit" class="unsichtbar" tabindex="-1" aria-hidden="true">Auftrag erfassen</button>

    <fieldset class="kunde">
        <legend>Kunde</legend>
        <partial name="_Kundenauswahl" model="Model.Kundenauswahl" />
        <span asp-validation-for="KundeId" class="feldfehler"></span>
        <div class="neukunde">
            <p class="erklaerung">Gibt es zur E-Mail-Adresse schon einen Kunden, wird der Auftrag ihm zugeordnet.</p>
            <div class="reihe">
                <div class="feld">
                    <label asp-for="Eingabe.KundeName">Name</label>
                    <input asp-for="Eingabe.KundeName" autocomplete="off" />
                    <span asp-validation-for="Eingabe.KundeName" class="feldfehler"></span>
                </div>
                <div class="feld">
                    <label asp-for="Eingabe.KundeEmail">E-Mail</label>
                    <input asp-for="Eingabe.KundeEmail" type="email" autocomplete="off" />
                    <span asp-validation-for="Eingabe.KundeEmail" class="feldfehler"></span>
                </div>
                <div class="feld">
                    <label asp-for="Eingabe.KundeTelefon">Telefon</label>
                    <input asp-for="Eingabe.KundeTelefon" autocomplete="off" />
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>Auftrag</legend>
        <partial name="_Auftragsfelder" for="Eingabe.Felder" view-data='new ViewDataDictionary(ViewData) { ["Auswahl"] = Model.Auswahl }' />
        <div class="feld">
            <partial name="_Dateifeld" model='"dateien"' />
            <span asp-validation-for="Dateien" class="feldfehler"></span>
        </div>
    </fieldset>

    <fieldset>
        <legend>Zuordnung</legend>
        <div class="reihe">
            <div class="feld">
                <label asp-for="Eingabe.Eingang">Eingang</label>
                <select asp-for="Eingabe.Eingang">
                    <option value="@Eingang.Telefon">Telefon</option>
                    <option value="@Eingang.EMail">E-Mail</option>
                    <option value="@Eingang.Web">Web</option>
                </select>
            </div>
            <div class="feld">
                <label asp-for="Eingabe.GruppeId">Gruppe</label>
                <select asp-for="Eingabe.GruppeId" asp-items="Model.Gruppen"></select>
            </div>
        </div>
    </fieldset>

    <div class="knoepfe">
        <button type="submit" class="haupt">Auftrag erfassen</button>
        <button type="submit" name="Eingabe.SofortUebernehmen" value="true">Erfassen und selbst übernehmen</button>
        <a asp-page="/Index">Abbrechen</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/kundensuche.js" asp-append-version="true"></script>
    <script src="~/js/geraetesuche.js" asp-append-version="true"></script>
}
