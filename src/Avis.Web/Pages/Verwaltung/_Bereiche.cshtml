@{
    var seite = ViewContext.RouteData.Values["page"] as string ?? "";
    string? Aktuell(string name) => seite.StartsWith("/Verwaltung/" + name) ? "page" : null;
}
<nav class="filter" aria-label="Bereiche der Verwaltung">
    <a asp-page="/Verwaltung/Gruppen" aria-current="@Aktuell("Gruppe")">Gruppen</a>
    <a asp-page="/Verwaltung/Benutzer" aria-current="@Aktuell("Benutzer")">Benutzer</a>
    <a asp-page="/Verwaltung/Kategorien" aria-current="@Aktuell("Kategorien")">Kategorien</a>
    <a asp-page="/Verwaltung/Standorte" aria-current="@Aktuell("Standorte")">Standorte</a>
    <a asp-page="/Verwaltung/Mails" aria-current="@Aktuell("Mails")">Mails</a>
    <a asp-page="/Verwaltung/Posteingang" aria-current="@Aktuell("Posteingang")">Posteingang</a>
</nav>
