@page
@model GeraeteabgleichModel
@{
    ViewData["Title"] = "Geräteabgleich";
}
<h1>Verwaltung</h1>
<partial name="_Bereiche" />
<h2>Geräteabgleich</h2>

@if (!Model.Eingerichtet)
{
    <p class="erklaerung">
        Der Abgleich ist ausgeschaltet (<code>Geraeteabgleich:Art = @Model.Optionen.Art</code>). Geräte werden nur in AVIS gepflegt.
        Mit <code>SnipeIt</code>, der Adresse der Installation und einem Zugangsschlüssel kommen die Geräte aus Snipe-IT.
    </p>
}
else
{
    <p class="erklaerung">
        Quelle: <strong>@Model.Optionen.Art</strong>@if (!string.IsNullOrWhiteSpace(Model.Optionen.Adresse)) {<text>, <code>@Model.Optionen.Adresse</code></text>}.
        AVIS liest dort nur. Die Quelle gewinnt: Inventarnummer, Bezeichnung, Typ, Standort und Nutzer werden überschrieben.
        Was dort fehlt, wird nicht gelöscht, sondern ausgemustert. Geräte, die nur in AVIS angelegt wurden, bleiben unberührt.
        Der Nutzer wird über die E-Mail-Adresse eines Kunden zugeordnet.
    </p>
    <p class="erklaerung">Der Abgleich läuft täglich um @Model.Optionen.Laufzeit.ToString("HH:mm") Uhr. Lief AVIS zu dieser Zeit nicht, wird er nachgeholt.</p>

    <partial name="_Abgleichergebnis" model='new Abgleichanzeige(Model.Letztes, "Wieder in Betrieb", "Ausgemustert")' />

    <form method="post">
        <button type="submit" class="haupt">Jetzt abgleichen</button>
    </form>
}
