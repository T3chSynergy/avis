@model IStammliste
<h1>Verwaltung</h1>
<partial name="_Bereiche" />
<h2>@Model.Titel</h2>
<p class="erklaerung">@Model.Erklaerung Deaktivierte Einträge stehen nicht mehr zur Auswahl, bleiben an bestehenden Aufträgen aber erhalten.</p>

@if (Model.Eintraege.Count == 0)
{
    <p class="leer">Noch keine Einträge.</p>
}
else
{
    <table class="liste schmal">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Aktiv</th>
                <th scope="col"><span class="unsichtbar">Aktion</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Eintraege)
            {
                var form = $"eintrag-{e.Id}";
                <tr class="@(e.Aktiv ? "" : "inaktiv")">
                    <td>
                        <label class="unsichtbar" for="name-@e.Id">Name</label>
                        <input id="name-@e.Id" name="name" value="@e.Name" maxlength="100" required form="@form" />
                    </td>
                    <td>
                        <input type="checkbox" id="aktiv-@e.Id" name="aktiv" value="true" checked="@e.Aktiv" form="@form" />
                        <label class="unsichtbar" for="aktiv-@e.Id">@e.Name aktiv</label>
                    </td>
                    <td>
                        <form method="post" id="@form" asp-page-handler="Speichern" asp-route-id="@e.Id">
                            <button type="submit">Speichern</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<form method="post" asp-page-handler="Anlegen" class="kasten">
    <h3>@Model.Einzahl anlegen</h3>
    <label for="neu-name">Name</label>
    <input id="neu-name" name="name" maxlength="100" required />
    <button type="submit" class="haupt">Anlegen</button>
</form>
