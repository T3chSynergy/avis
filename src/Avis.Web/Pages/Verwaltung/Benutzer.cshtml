@page
@model BenutzerModel
@{
    ViewData["Title"] = "Benutzer";
    string? Aktuell(string auswahl) => Model.Auswahl == auswahl ? "page" : null;
    // Der Suchbegriff bleibt beim Wechsel der Auswahl erhalten.
    var q = string.IsNullOrWhiteSpace(Model.Q) ? null : Model.Q;
}
<h1>Verwaltung</h1>
<partial name="_Bereiche" />
<h2>Benutzer</h2>
<p class="erklaerung">
    Jeder, der sich anmeldet, bekommt ein Konto ohne Rolle, auch jeder Kunde. Die Liste zeigt deshalb zuerst nur, wer eine Rolle hat.
    Bearbeiter lassen sich auch vorab anlegen.
</p>

<form method="get" class="suchzeile" role="search">
    <div class="feld breit">
        <label for="q">Suche nach Name, Anmeldename oder E-Mail</label>
        <input id="q" name="q" value="@Model.Q" type="search" autocomplete="off" />
    </div>
    @if (Model.Auswahl != BenutzerModel.MitRolle)
    {
        <input type="hidden" name="zeigen" value="@Model.Auswahl" />
    }
    <button type="submit" class="haupt">Suchen</button>
</form>

@* Die Zahlen gelten für die Suche: So ist zu sehen, wo die Treffer stehen, auch wenn die gewählte Auswahl leer ist. *@
<nav class="filter" aria-label="Auswahl der Konten">
    <a asp-page="Benutzer" asp-route-q="@q" aria-current="@Aktuell(BenutzerModel.MitRolle)">Mit Rolle (@Model.Anzahl.MitRolle)</a>
    <a asp-page="Benutzer" asp-route-q="@q" asp-route-zeigen="@BenutzerModel.NurAdministratoren" aria-current="@Aktuell(BenutzerModel.NurAdministratoren)">Administratoren (@Model.Anzahl.Administratoren)</a>
    <a asp-page="Benutzer" asp-route-q="@q" asp-route-zeigen="@BenutzerModel.OhneRolle" aria-current="@Aktuell(BenutzerModel.OhneRolle)">Ohne Rolle (@Model.Anzahl.OhneRolle)</a>
    <a asp-page="Benutzer" asp-route-q="@q" asp-route-zeigen="@BenutzerModel.Alle" aria-current="@Aktuell(BenutzerModel.Alle)">Alle (@Model.Anzahl.Alle)</a>
</nav>

@if (Model.Benutzer.Count == 0)
{
    <p class="leer">Keine Benutzer gefunden.</p>
}
else
{
    <table class="liste">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Anmeldename</th>
                <th scope="col">Rolle</th>
                <th scope="col">Gruppen</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Benutzer)
            {
                <tr class="@(b.Aktiv ? "" : "inaktiv")">
                    <td><a asp-page="BenutzerBearbeiten" asp-route-id="@b.Id">@b.Name</a></td>
                    <td>@b.Anmeldename</td>
                    <td>@b.Rolle.Text() @if (b.AusQuelle) { <span class="hinweis">abgeglichen</span> }</td>
                    <td>@b.Gruppen</td>
                    <td>@(b.Aktiv ? "aktiv" : "deaktiviert")</td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Gekuerzt)
    {
        <p class="erklaerung">Es werden die ersten @BenutzerModel.Hoechstzahl Benutzer angezeigt. Gib mehr ein, um die Suche einzugrenzen.</p>
    }
}

<form method="post" class="kasten">
    <h3>Benutzer anlegen</h3>
    <label for="neu-anmeldename">Anmeldename</label>
    <input id="neu-anmeldename" name="anmeldename" maxlength="200" required aria-describedby="neu-anmeldename-hinweis" autocomplete="off" />
    <p class="erklaerung" id="neu-anmeldename-hinweis">So wie Windows ihn meldet, mit Domäne: domäne\name</p>
    <label for="neu-name">Name</label>
    <input id="neu-name" name="name" maxlength="200" required autocomplete="off" />
    <label for="neu-rolle">Rolle</label>
    <select id="neu-rolle" name="rolle">
        <option value="@Rolle.Bearbeiter">Bearbeiter</option>
        <option value="@Rolle.Administrator">Administrator</option>
        <option value="@Rolle.Keine">keine</option>
    </select>
    <button type="submit" class="haupt">Anlegen</button>
</form>
