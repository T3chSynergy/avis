@page
@model KundenabgleichModel
@{
    ViewData["Title"] = "Kundenabgleich";
}
<h1>Verwaltung</h1>
<partial name="_Bereiche" />
<h2>Kundenabgleich</h2>

@if (!Model.Eingerichtet)
{
    <p class="erklaerung">
        Der Abgleich ist ausgeschaltet (<code>Kundenabgleich:Art = @Model.Optionen.Art</code>). Kunden werden nur in AVIS gepflegt.
        Mit <code>ActiveDirectory</code> und einem LDAP-Filter in <code>Kundenabgleich:Filter</code> sind die Benutzerkonten, auf die der Filter passt, die Kunden.
    </p>
}
else
{
    <p class="erklaerung">
        Quelle: <strong>@Model.Optionen.Art</strong>@if (!string.IsNullOrWhiteSpace(Model.Optionen.Filter)) {<text>, Filter <code>@Model.Optionen.Filter</code></text>}@if (!string.IsNullOrWhiteSpace(Model.Optionen.Suchbasis)) {<text>, gesucht in <code>@Model.Optionen.Suchbasis</code></text>}.
        Die Quelle gewinnt: Name, E-Mail, Telefon, Organisationseinheit und Standort werden überschrieben.
        Wer dort fehlt, wird nicht gelöscht, sondern als inaktiv markiert. Kunden, die nur in AVIS angelegt wurden, bleiben unberührt.
    </p>
    <p class="erklaerung">Der Abgleich läuft täglich um @Model.Optionen.Laufzeit.ToString("HH:mm") Uhr. Lief AVIS zu dieser Zeit nicht, wird er nachgeholt.</p>

    <partial name="_Abgleichergebnis" model='new Abgleichanzeige(Model.Letztes, "Wieder aktiv", "Als inaktiv markiert")' />

    <form method="post">
        <button type="submit" class="haupt">Jetzt abgleichen</button>
    </form>
}
