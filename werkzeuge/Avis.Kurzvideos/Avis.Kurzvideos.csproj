<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nimmt die Kurzvideos zur Dokumentation auf. Das Projekt gehört absichtlich nicht zu Avis.slnx:
       Die Prüfungen und das Paket brauchen es nicht, und Playwright ist ein großes Paket. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Einblendung.js" LogicalName="Einblendung.js" />
    <EmbeddedResource Include="Seite.css" LogicalName="Seite.css" />
    <EmbeddedResource Include="../../src/Avis.Web/wwwroot/favicon.ico" LogicalName="favicon.ico" Link="favicon.ico" />
  </ItemGroup>

</Project>
